# Połączenie z Neon. Wklej connection string POOLED (w hoście jest słowo -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Klucz z resend.com → API Keys. Zaczyna się od re_
RESEND_API_KEY=re_twoj_klucz

# Nadawca. Zostaw onboarding@resend.dev na czas testów.
# Po podpięciu własnej domeny w Resend zmień na np.:
# RESEND_FROM=Easy Builders <biuro@twojadomena.pl>
RESEND_FROM=Easy Builders <onboarding@resend.dev>
